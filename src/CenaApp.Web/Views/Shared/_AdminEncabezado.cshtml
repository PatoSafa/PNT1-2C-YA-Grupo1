@* Header de las pantallas de administración, con pestañas (Panel, Recetas, Ingredientes, Catálogos y, para el SuperAdmin, Usuarios) y cierre de sesión. *@
@{
    var actual = ViewContext.RouteData.Values["controller"] as string;
    var accion = actual == "AdminCatalogos" ? ViewContext.RouteData.Values["action"] as string : null;
}
<header class="encabezado encabezado-admin">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1><i class="bi bi-gear"></i> Administración</h1>
            <p>@(User.IsInRole("SuperAdmin") ? "Catálogo y usuarios" : "Catálogo de recetas e ingredientes")</p>
        </div>
        <form asp-controller="Cuenta" asp-action="Salir" method="post" data-confirmar="¿Cerrar sesión?">
            <button type="submit" class="btn btn-vidrio btn-sm"><i class="bi bi-box-arrow-right"></i> Salir</button>
        </form>
    </div>
    <nav class="pestanas-admin mt-3">
        <a asp-controller="AdminCatalogos" asp-action="Panel" class="@(accion == "Panel" ? "activo" : "")">Panel</a>
        <a asp-controller="AdminRecetas" asp-action="Index" class="@(actual == "AdminRecetas" ? "activo" : "")">Recetas</a>
        <a asp-controller="AdminIngredientes" asp-action="Index" class="@(actual == "AdminIngredientes" ? "activo" : "")">Ingredientes</a>
        <a asp-controller="AdminCatalogos" asp-action="Catalogos" class="@(accion == "Catalogos" ? "activo" : "")">Catálogos</a>
        @if (User.IsInRole("SuperAdmin"))
        {
            <a asp-controller="AdminUsuarios" asp-action="Index" class="@(actual == "AdminUsuarios" ? "activo" : "")">Usuarios</a>
        }
    </nav>
</header>
