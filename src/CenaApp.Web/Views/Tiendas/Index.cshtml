@* Tiendas cercanas (DISENO.md §1.6): filtros por ingredientes y tipo, mapa y lista de comercios (D-20).
   La lista (#lista-comercios) la trae js/tiendas.js de /Tiendas/Buscar después de pedir la ubicación al navegador. *@
@model CenaApp.Web.ViewModels.TiendasViewModel
@{
    ViewData["Title"] = "Tiendas";
    ViewData["Seccion"] = "Tiendas";

    // Lo que necesita js/tiendas.js: el punto por defecto y los filtros con los que arranca.
    var datosIniciales = new
    {
        centro = new { lat = Model.Centro.Lat, lng = Model.Centro.Lng, nombre = Model.Centro.Nombre },
        tipo = Model.Tipo ?? "",
        ingredientes = Model.Ingredientes.Select(i => i.Id),
    };
}

@section Estilos {
    @* Leaflet + OpenStreetMap, complementaria aprobada (D-11). integrity: el navegador rechaza el archivo si alguien lo modificó. *@
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
}

<header class="encabezado encabezado-tiendas">
    <h1>Tiendas Cercanas</h1>
    <p>Encontrá dónde comprar tus ingredientes.</p>
</header>

<div class="cuerpo">
    <section class="tarjeta superpuesta">
        @if (Model.Ingredientes.Count > 0)
        {
            <p class="small fw-medium mb-2"><i class="bi bi-cart"></i> Buscando dónde comprar:</p>
            <div class="chips mb-3" id="filtro-ingredientes">
                @foreach (var (id, nombre) in Model.Ingredientes)
                {
                    <span class="etiqueta etiqueta-despensa" data-ingrediente="@id">
                        @nombre
                        <button type="button" class="quitar-ingrediente" aria-label="Dejar de buscar @nombre"><i class="bi bi-x"></i></button>
                    </span>
                }
            </div>
        }
        <div class="chips" id="filtro-tipos">
            <button type="button" class="chip chip-tiendas @(Model.Tipo is null ? "activo" : "")" data-tipo="">Todas</button>
            @foreach (var tipo in Model.Tipos)
            {
                <button type="button" class="chip chip-tiendas @(tipo == Model.Tipo ? "activo" : "")" data-tipo="@tipo">@tipo</button>
            }
        </div>
        <p id="estado-ubicacion" class="small text-secondary mt-3 mb-0" aria-live="polite">
            <span class="spinner-border spinner-border-sm text-success"></span> Pidiendo tu ubicación…
        </p>
    </section>

    <div id="mapa" class="mapa mb-3" aria-label="Mapa de comercios"></div>
    <p id="mapa-error" class="alert alert-warning small" hidden>No se pudo cargar el mapa. Igual podés ver los comercios en la lista.</p>

    <div id="lista-comercios" aria-live="polite">
        <div class="vacio"><span class="spinner-border text-success"></span><p class="mt-2">Buscando comercios cercanos…</p></div>
    </div>
    <noscript><p class="alert alert-warning">Para ver los comercios cercanos hace falta JavaScript.</p></noscript>
</div>

<script id="datos-tiendas" type="application/json">@Json.Serialize(datosIniciales)</script>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/tiendas.js" asp-append-version="true"></script>
}
