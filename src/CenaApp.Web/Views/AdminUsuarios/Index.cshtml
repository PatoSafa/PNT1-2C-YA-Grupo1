@* Administración de usuarios (SuperAdmin, D-22): buscar, filtrar por rol, crear, editar y eliminar. *@
@model List<CenaApp.Web.ViewModels.UsuarioFilaViewModel>
@{
    ViewData["Title"] = "Usuarios";
    ViewData["OcultarBarra"] = true;
    var rolElegido = ViewData["Rol"] as Rol?;
    var idActual = UsuarioActual.Id(User);
}

<partial name="_AdminEncabezado" />

<div class="cuerpo">
    <section class="tarjeta superpuesta">
        <form asp-action="Index" method="get" class="d-flex gap-2 flex-wrap" role="search">
            <div class="buscador flex-grow-1">
                <i class="bi bi-search"></i>
                <input type="search" name="buscar" value="@ViewData["Buscar"]" class="form-control borde" placeholder="Email o nombre..." aria-label="Buscar usuarios" />
            </div>
            <select name="rol" class="form-select w-auto" aria-label="Filtrar por rol" data-enviar-al-cambiar>
                <option value="">Todos los roles</option>
                @foreach (var rol in Enum.GetValues<Rol>())
                {
                    <option value="@rol" selected="@(rol == rolElegido)">@rol</option>
                }
            </select>
            <a asp-action="Crear" class="btn btn-primary text-nowrap"><i class="bi bi-plus-lg"></i> Nuevo</a>
        </form>
    </section>

    @* Qué puede ver cada rol (D-22). *@
    <details class="tarjeta">
        <summary class="fw-medium"><i class="bi bi-shield-lock"></i> Qué puede ver cada rol</summary>
        <ul class="list-unstyled small mt-2 mb-0">
            @foreach (var (rol, puede) in PermisosPorRol.Todos)
            {
                <li class="mb-1"><span class="etiqueta-rol rol-@rol.ToString().ToLower()">@rol</span> @puede</li>
            }
        </ul>
    </details>

    <p class="small text-secondary">@Model.Count @(Model.Count == 1 ? "usuario" : "usuarios")</p>

    @foreach (var u in Model)
    {
        <article class="tarjeta fila-admin @(u.Activo ? "" : "inactivo")">
            <div class="flex-grow-1 min-w-0">
                <h2 class="fs-6 mb-1 text-truncate">@u.Email</h2>
                <p class="small text-secondary mb-1">@(string.IsNullOrEmpty(u.Nombre) ? "Sin perfil todavía" : u.Nombre) · desde @u.CreadoEn.ToLocalTime().ToString("dd/MM/yyyy")</p>
                <div class="d-flex flex-wrap gap-1 align-items-center">
                    <span class="etiqueta-rol rol-@u.Rol.ToString().ToLower()">@u.Rol</span>
                    @if (!u.Activo)
                    {
                        <span class="etiqueta-rol rol-inactivo"><i class="bi bi-slash-circle"></i> Desactivado</span>
                    }
                    @if (u.Id == idActual)
                    {
                        <span class="small text-secondary">(vos)</span>
                    }
                    <span class="small text-secondary">❤ @u.Favoritos · 🧺 @u.EnDespensa</span>
                </div>
            </div>
            <div class="d-flex flex-column gap-1">
                <a asp-action="Editar" asp-route-id="@u.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i> Editar</a>
                <form asp-action="Eliminar" asp-route-id="@u.Id" method="post"
                      data-confirmar="¿Eliminar a @u.Email? También se borran su perfil, sus favoritos y su despensa.">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100" disabled="@(u.Id == idActual)"
                            title="@(u.Id == idActual ? "No podés eliminar tu propia cuenta" : "Eliminar")">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                </form>
            </div>
        </article>
    }
</div>
