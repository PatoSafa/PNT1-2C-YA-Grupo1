@* Parte de la Despensa que cambia con cada acción: aviso, accesos rápidos, tabla "Tengo en casa", la favorita elegida
   y las recetas sugeridas. La devuelven Agregar / Cambiar / Quitar / Vaciar / Contenido para que js/despensa.js
   la reemplace sin recargar. *@
@using System.Globalization
@model CenaApp.Web.ViewModels.DespensaContenidoViewModel
@{
    var ar = CultureInfo.GetCultureInfo("es-AR");
    // Los <input type="number"> esperan punto decimal.
    string ParaInput(decimal? valor) => valor?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";
}

@* Token antiforgery que usan los fetch de esta pantalla (se renueva con cada respuesta). *@
@Html.AntiForgeryToken()

@if (Model.Mensaje is not null)
{
    <div class="alert @(Model.MensajeOk ? "alert-success" : "alert-warning") py-2 aviso-temporal" role="status">
        <i class="bi @(Model.MensajeOk ? "bi-check-circle" : "bi-exclamation-circle")"></i> @Model.Mensaje
    </div>
}

@if (Model.Rapidos.Count > 0)
{
    <div class="chips mb-3" aria-label="Agregar rápido">
        @foreach (var i in Model.Rapidos)
        {
            <form asp-action="Agregar" method="post" class="form-despensa">
                <input type="hidden" name="texto" value="@i.Nombre" />
                <button type="submit" class="chip"><i class="bi bi-plus"></i> @i.Nombre</button>
            </form>
        }
    </div>
}

<section class="tarjeta">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="fs-6 mb-0">Tengo en casa (@Model.Ingredientes.Count)</h2>
        @if (Model.Ingredientes.Count > 0)
        {
            <form asp-action="Vaciar" method="post" class="form-despensa" data-confirmar="¿Vaciar toda la despensa? Se van a quitar los @Model.Ingredientes.Count ingredientes.">
                <button type="submit" class="btn btn-link btn-sm text-danger p-0">Limpiar todo</button>
            </form>
        }
    </div>

    @if (Model.Ingredientes.Count == 0)
    {
        <div class="vacio py-3">
            <span class="icono">🥦</span>
            <p class="fw-medium text-body mb-1">¿Qué tenés en casa?</p>
            <p class="mb-0">Ingresá los ingredientes disponibles y te mostramos qué podés cocinar ahora mismo.</p>
        </div>
    }
    else
    {
        <p class="small text-secondary mb-2">La cantidad es opcional: si la dejás vacía, contamos que te alcanza para cualquier receta.</p>
        <table class="table table-sm align-middle tabla-despensa mb-0">
            <thead>
                <tr>
                    <th scope="col">Ingrediente</th>
                    <th scope="col">Cantidad</th>
                    <th scope="col"><span class="visually-hidden">Quitar</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Ingredientes)
                {
                    <tr>
                        <td class="fw-medium">@i.Nombre</td>
                        <td>
                            @* Se guarda solo al tocar ✓ (o Enter). *@
                            <form asp-action="Cambiar" asp-route-id="@i.IngredienteId" method="post" class="form-despensa d-flex gap-1">
                                <input type="number" name="cantidad" value="@ParaInput(i.Cantidad)" min="0.01" step="any"
                                       class="form-control form-control-sm cantidad" placeholder="—" aria-label="Cantidad de @i.Nombre" />
                                <select name="unidad" class="form-select form-select-sm unidad" aria-label="Unidad de @i.Nombre">
                                    @foreach (var u in i.Unidades)
                                    {
                                        <option value="@u" selected="@(u == i.Unidad)">@u</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-success" aria-label="Guardar cantidad de @i.Nombre" title="Guardar cantidad">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            </form>
                        </td>
                        <td class="text-end">
                            <form asp-action="Quitar" asp-route-id="@i.IngredienteId" method="post" class="form-despensa"
                                  data-confirmar="¿Quitar @i.Nombre de tu despensa?">
                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" aria-label="Quitar @i.Nombre" title="Quitar">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@* "¿Qué me falta para...?": cualquiera de las favoritas, aunque no llegue al 50 %. *@
@if (Model.Favoritas.Count > 0)
{
    <section class="tarjeta">
        <label for="favorita" class="fs-6 fw-medium mb-2 d-block"><i class="bi bi-heart-fill text-danger"></i> ¿Qué me falta para una favorita?</label>
        <select id="favorita" name="favorita" class="form-select">
            <option value="">Elegí una receta favorita…</option>
            @foreach (var (id, nombre) in Model.Favoritas)
            {
                <option value="@id" selected="@(id == Model.FavoritaElegida)">@nombre</option>
            }
        </select>
        @if (Model.AnalisisFavorita is { } f)
        {
            <div class="mt-3">
                <partial name="_RecetaParcial" model="f" />
            </div>
        }
    </section>
}

@if (Model.Ingredientes.Count > 0)
{
    <div class="segmentado mb-3" role="tablist">
        <button class="active" data-bs-toggle="tab" data-bs-target="#podes" type="button" role="tab">
            <i class="bi bi-check-circle"></i> Podés cocinar (@Model.PodesCocinar.Count)
        </button>
        <button class="casi" data-bs-toggle="tab" data-bs-target="#casi" type="button" role="tab">
            <i class="bi bi-exclamation-circle"></i> Casi listas (@Model.CasiListas.Count)
        </button>
    </div>

    <div class="tab-content">
        <section class="tab-pane fade show active" id="podes" role="tabpanel">
            @if (Model.PodesCocinar.Count == 0)
            {
                <div class="vacio">
                    <i class="bi bi-egg-fried icono"></i>
                    <p class="mb-1">Ninguna receta se puede hacer con estos ingredientes solos.</p>
                    <p class="mb-0">Revisá las recetas "Casi listas" para ver qué te falta comprar.</p>
                </div>
            }
            @foreach (var r in Model.PodesCocinar)
            {
                <a asp-controller="Recetas" asp-action="Detalle" asp-route-id="@r.Id" class="tarjeta-despensa completa">
                    <span class="emoji">@r.Emoji</span>
                    <span class="flex-grow-1">
                        <span class="d-block fw-medium">@r.Nombre</span>
                        <span class="d-block small text-success">Tenés todos los ingredientes</span>
                        <span class="meta mt-1">⏱ @r.TiempoMin min <partial name="_Dificultad" model="r.Dificultad" /></span>
                    </span>
                    <i class="bi bi-chevron-right text-secondary"></i>
                </a>
            }
        </section>

        <section class="tab-pane fade" id="casi" role="tabpanel">
            @if (Model.CasiListas.Count == 0)
            {
                <div class="vacio">
                    <p class="mb-1">No hay recetas con al menos el 50% de ingredientes disponibles.</p>
                    <p class="mb-0">Agregá más ingredientes para ver más sugerencias.</p>
                </div>
            }
            @foreach (var r in Model.CasiListas)
            {
                <partial name="_RecetaParcial" model="r" />
            }
        </section>
    </div>
}
